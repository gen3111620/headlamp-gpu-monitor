{
  "name": "headlamp-gpu-monitor",
  "version": "0.1.0",
  "description": "NVIDIA GPU monitoring for Headlamp using DCGM Exporter and Prometheus.",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "package": "headlamp-plugin package . artifacts",
    "checksums": "node scripts/checksums.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs README.md docs",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs README.md docs",
    "lint": "eslint --max-warnings 0 --ext .ts,.tsx src tests",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:promql": "vitest run --config promql.config.ts",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "preview": "vite --config preview.config.mjs --host 0.0.0.0 --port 5178",
    "test:browser": "playwright test",
    "validate": "npm run format:check && npm run lint && npm run tsc && npm test && npm run build"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "gpu",
    "nvidia",
    "dcgm",
    "prometheus"
  ],
  "headlamp": {
    "extraDist": {
      "README.md": "README.md",
      "LICENSE": "LICENSE",
      "docs": "docs"
    }
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "es5"
  },
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ],
    "env": {
      "browser": true,
      "es2022": true
    },
    "rules": {
      "react/react-in-jsx-scope": "off"
    }
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0",
    "@playwright/test": "^1.56.0"
  }
}
